<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.wordaire.ui.splash.SplashFragment"
        android:label="Splash">
        <action
            android:id="@+id/action_splashFragment_to_categorySelectionFragment"
            app:destination="@id/categorySelectionFragment"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/categorySelectionFragment"
        android:name="com.example.wordaire.ui.categories.CategorySelectionFragment"
        android:label="Categories">
        <action
            android:id="@+id/action_categorySelectionFragment_to_levelSelectionFragment"
            app:destination="@id/levelSelectionFragment"
            app:enterAnim="@android:anim/slide_in_left"
            app:exitAnim="@android:anim/slide_out_right"
            app:popEnterAnim="@android:anim/slide_in_left"
            app:popExitAnim="@android:anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/levelSelectionFragment"
        android:name="com.example.wordaire.ui.levels.LevelSelectionFragment"
        android:label="Levels">
        <argument
            android:name="categoryId"
            app:argType="string" />
        <argument
            android:name="categoryName"
            app:argType="string" />
        <action
            android:id="@+id/action_levelSelectionFragment_to_gameplayFragment"
            app:destination="@id/gameplayFragment"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out"
            app:popEnterAnim="@android:anim/fade_in"
            app:popExitAnim="@android:anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/gameplayFragment"
        android:name="com.example.wordaire.ui.gameplay.GameplayFragment"
        android:label="Gameplay">
        <argument
            android:name="levelId"
            app:argType="string" />
        <argument
            android:name="levelNumber"
            app:argType="integer" />
    </fragment>

</navigation>
