<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/gameplayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gameplay_gradient">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="36dp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/levelTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Level 3"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/profileButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_powerup"
            android:backgroundTint="#43A047"
            android:src="@android:drawable/ic_menu_myplaces"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="@string/player_profile"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_powerup"
            android:backgroundTint="#43A047"
            android:src="@android:drawable/ic_menu_manage"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="@string/settings"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@android:color/white" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Top Info Row -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/movesPanel"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="#FFD54F"
        app:cardCornerRadius="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/moves"
                android:textColor="#3E2723"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/movesCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="64"
                android:textColor="#3E2723"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:id="@+id/stockContainer"
        android:layout_width="80dp"
        android:layout_height="110dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/movesPanel">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="#7B1FA2"
            app:cardCornerRadius="12dp"
            app:strokeColor="#FFFFFF"
            app:strokeWidth="2dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:src="@drawable/ic_menu_gallery"
                android:alpha="0.3"
                android:contentDescription="@string/stock" />
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:id="@+id/stockCount"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="8dp"
            android:background="@drawable/bg_circle_count"
            android:gravity="center"
            tools:text="13"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/drawnCardsContainer"
        android:layout_width="80dp"
        android:layout_height="110dp"
        app:layout_constraintBottom_toBottomOf="@id/stockContainer"
        app:layout_constraintEnd_toStartOf="@id/stockContainer"
        app:layout_constraintStart_toEndOf="@id/movesPanel"
        app:layout_constraintTop_toTopOf="@id/stockContainer" />

    <!-- Category Anchors -->
    <HorizontalScrollView
        android:id="@+id/foundationScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/stockContainer">
        <LinearLayout
            android:id="@+id/foundationRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">
            <!-- Anchors will be here -->
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Active Lanes -->
    <LinearLayout
        android:id="@+id/boardLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintTop_toBottomOf="@id/foundationScroll">
        <!-- 4 Lanes will be here -->
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/bannerContainer">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp">
            <ImageButton
                android:id="@+id/hintButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_powerup"
                android:backgroundTint="#FFD54F"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_info_details"
                android:contentDescription="@string/hint"
                app:tint="#3E2723" />
            <TextView
                android:id="@+id/hintCount"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_circle_count"
                android:gravity="center"
                android:text="3"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp">
            <ImageButton
                android:id="@+id/undoButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_powerup"
                android:backgroundTint="#AB47BC"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="@string/undo"
                app:tint="@android:color/white" />
            <TextView
                android:id="@+id/undoCount"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_circle_count"
                android:gravity="center"
                android:text="3"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp">
            <ImageButton
                android:id="@+id/magnetButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_powerup"
                android:backgroundTint="#64B5F6"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/btn_star_big_on"
                android:contentDescription="@string/magnet"
                app:tint="@android:color/white" />
            <TextView
                android:id="@+id/magnetCount"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_circle_count"
                android:gravity="center"
                android:text="3"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

    </LinearLayout>

    <!-- Banner Ad Container -->
    <FrameLayout
        android:id="@+id/bannerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent" />

    <FrameLayout
        android:id="@+id/overlayContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="100dp"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
