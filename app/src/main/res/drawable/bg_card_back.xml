<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#7B1FA2" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <!-- Pattern layer -->
    <item android:top="8dp" android:bottom="8dp" android:left="8dp" android:right="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="#9C27B0" android:dashWidth="10dp" android:dashGap="4dp" />
        </shape>
    </item>

    <!-- Center logo placeholder -->
    <item android:gravity="center" android:width="32dp" android:height="32dp">
        <shape android:shape="oval">
            <solid android:color="#9C27B0" />
            <stroke android:width="2dp" android:color="#E1BEE7" />
        </shape>
    </item>
</layer-list>